# =============================================================================
# TEESOULZ ADMIN PORTAL -- ENVIRONMENT VARIABLES TEMPLATE
# Target Production URL: https://teesoulz-admin.vercel.app
# =============================================================================

# 1. SUPABASE CLIENT KEYS (Safe for browser usage)
# Found in: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# 2. SUPABASE SERVICE ROLE KEY (CRITICAL SECRET - SERVER CONTEXT ONLY)
# Found in: Supabase Dashboard -> Project Settings -> API -> service_role key
# NEVER prefix with NEXT_PUBLIC_! It completely bypasses PostgreSQL RLS.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# 3. APPLICATION & STOREFRONT URLS
NEXT_PUBLIC_SITE_URL=https://teesoulz-admin.vercel.app
NEXT_PUBLIC_STOREFRONT_URL=https://teesoulz.vercel.app
